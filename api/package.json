{
  "name": "nest-js-service-template",
  "version": "0.0.0",
  "description": "Service bootstrap to quickstart new microservices",
  "author": "Tech Team <tech-team@implicity.com>",
  "private": true,
  "license": "Implicity Proprietary",
  "engines": {
    "node": ">=18.15.0"
  },
  "engineStrict": true,
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build && npm run copy:assets",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --passWithNoTests",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "lint:fix": "tslint -p tsconfig.json -c tslint.json --fix",
    "migrate:dev": "npm run build; npm run migrate",
    "rollback:dev": "npm run build; npm run rollback",
    "migrate": "node_modules/.bin/typeorm migration:run -f dist/config/database-migration.config.js",
    "rollback": "node_modules/.bin/typeorm migration:revert -f dist/config/database-migration.config.js",
    "copy:assets": "cpx 'src/**/*.{html,png,jpg,pug,sql,env,pdf,json,bson,jar,csv,js,hl7,xml,bnk,log,21X,22X,PDF}' 'dist'"
  },
  "dependencies": {
    "@faker-js/faker": "^8.0.2",
    "@implicity-healthcare/i18n": "1.0.98",
    "@implicity-healthcare/nest-criteria": "10.1.0",
    "@implicity-healthcare/nest-logger": "10.2.0",
    "@implicity-healthcare/nest-rabbit": "10.0.2",
    "@implicity-healthcare/nest-toolkit": "10.7.0",
    "@nestjs/common": "10.4.11",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.11",
    "@nestjs/microservices": "10.4.11",
    "@nestjs/platform-express": "10.4.11",
    "@nestjs/schedule": "4.1.1",
    "@nestjs/swagger": "7.4.2",
    "@nestjs/terminus": "10.2.3",
    "@nestjs/typeorm": "10.0.2",
    "bluebird": "3.7.2",
    "body-parser": "1.20.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "dayjs": "1.11.13",
    "pg": "8.13.1",
    "reflect-metadata": "0.1.14",
    "rimraf": "6.0.1",
    "rxjs": "7.8.1",
    "swagger-ui-express": "5.0.1",
    "typeorm": "0.3.20"
  },
  "devDependencies": {
    "@implicity-healthcare/eslint-config": "1.3.0",
    "@implicity-healthcare/nest-core-service-schematics": "9.0.0",
    "@nestjs/cli": "10.4.8",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.11",
    "@types/amqp-connection-manager": "3.4.5",
    "@types/bluebird": "3.5.42",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/lodash": "4.17.13",
    "@types/node": "20.14.8",
    "@types/supertest": "6.0.2",
    "@types/validator": "13.12.2",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "cpx": "1.5.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "3.6.1",
    "eslint-plugin-import": "2.29.1",
    "husky": "9.1.4",
    "jest": "29.7.0",
    "lint-staged": "15.2.7",
    "supertest": "6.3.3",
    "ts-jest": "29.1.0",
    "ts-loader": "9.4.3",
    "ts-node": "10.9.1",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.0.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "coverageReporters": [
      "lcov",
      "cobertura",
      "text"
    ]
  }
}
